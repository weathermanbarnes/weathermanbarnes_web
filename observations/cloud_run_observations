#         "output_bucket_name": "'"${GCS_PLOT_BUCKET}"'",
#         "output_blob_name": "ecmwf_plot_$(date +\\%Y\\%m\\%d).png"
#     }' \
#     --headers "Content-Type=application/json" \
#     --location "${CLOUD_RUN_REGION}" \
#     --oauth-service-account-email "${CLOUD_RUN_SERVICE_ACCOUNT_EMAIL}" \
#     --oauth-token-scope https://www.googleapis.com/auth/cloud-platform
# 
# if [ $? -ne 0 ]; then
#     echo "ERROR: Cloud Scheduler job creation failed."
# else
#     echo "Cloud Scheduler job created successfully."
# fi

# --- Manual Test (Alternative to Step 7 for a single run) ---
echo "--- Manual Test: Triggering Cloud Run Service (for single run testing) ---"
echo "You can run this command anytime to manually trigger your service."
echo "Triggering Cloud Run service at: ${CLOUD_RUN_SERVICE_URL}/generate-plot"

curl -X POST -H "Content-Type: application/json" \
     -d '{
         "ecmwf_data_bucket": "ecmwf-open-data",
         "ecmwf_data_blob": "20250723/12z/ifs/0p25/oper/20250723120000-0h-oper-fc.grib2",
         "output_bucket_name": "www.weathermanbarnes.com",
         "fignum": 0
     }' \
     "${CLOUD_RUN_SERVICE_URL}/generate-plot"

echo "Script execution complete."




#############

export GCP_PROJECT_ID="diesel-air-405712" 
export GCS_PLOT_BUCKET="www.weathermanbarnes.com" 
export CLOUD_RUN_SERVICE_NAME="obs-plot-service"
export CLOUD_RUN_REGION="us-central1"
export DOCKER_IMAGE_NAME="obs-plot-generator"
export DOCKER_IMAGE_TAG="latest"

# --- Step 4: Build and Push Your Docker Image to Google Container Registry ---
echo "--- Step 4: Building and Pushing Docker Image ---"
export FULL_IMAGE_NAME="gcr.io/${GCP_PROJECT_ID}/${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"
echo "Building and pushing Docker image: ${FULL_IMAGE_NAME}"
gcloud builds submit --tag "${FULL_IMAGE_NAME}" .

# --- Step 5: Deploy Your Application to Google Cloud Run ---
echo "--- Step 5: Deploying Application to Google Cloud Run ---"
echo "Deploying Cloud Run service: ${CLOUD_RUN_SERVICE_NAME} in region ${CLOUD_RUN_REGION}"
gcloud run deploy "${CLOUD_RUN_SERVICE_NAME}" \
  --image "${FULL_IMAGE_NAME}" \
  --platform managed \
  --region "${CLOUD_RUN_REGION}" \
  --allow-unauthenticated \
  --set-env-vars BUCKET_NAME="${GCS_PLOT_BUCKET}" 

export CLOUD_RUN_SERVICE_URL=$(gcloud run services describe "${CLOUD_RUN_SERVICE_NAME}" --platform managed --region "${CLOUD_RUN_REGION}" --format="value(status.url)")
echo "Cloud Run service deployed. Service URL: ${CLOUD_RUN_SERVICE_URL}"

# --- Step 6: Configure IAM Permissions for Your Cloud Run Service Account ---
echo "--- Step 6: Configuring IAM Permissions ---"
export CLOUD_RUN_SERVICE_ACCOUNT_EMAIL=$(gcloud run services describe "${CLOUD_RUN_SERVICE_NAME}" --platform managed --region "${CLOUD_RUN_REGION}" --format="value(spec.template.spec.serviceAccountName)")
echo "Cloud Run Service Account: ${CLOUD_RUN_SERVICE_ACCOUNT_EMAIL}"

echo "Granting Storage Object Creator role to service account on bucket: gs://${GCS_PLOT_BUCKET}"
gsutil iam ch "serviceAccount:${CLOUD_RUN_SERVICE_ACCOUNT_EMAIL}:objectCreator" "gs://${GCS_PLOT_BUCKET}"

echo "IAM permissions configured."

gcloud run services update ${CLOUD_RUN_SERVICE_NAME} --memory 1Gi --cpu 1 --region us-central1 --platform managed --timeout 600

gcloud run services update ${CLOUD_RUN_SERVICE_NAME} \
--region us-central1 \
--add-volume=name=storage-volume,type=cloud-storage,bucket=www.weathermanbarnes.com \
--add-volume-mount=volume=storage-volume,mount-path=/mnt/storage \
